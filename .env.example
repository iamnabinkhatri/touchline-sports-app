# Local development mail settings. Replace placeholders; do not commit .env.
TOUCHLINE_ADMIN_PATH=
TOUCHLINE_ADMIN_NAME=Super Admin
TOUCHLINE_ADMIN_EMAIL=admin@example.com
TOUCHLINE_ADMIN_PASSWORD=change-this-password
TOUCHLINE_APP_BASE_URL=http://127.0.0.1:4173
TOUCHLINE_TIMEZONE=America/New_York
TOUCHLINE_SMTP_HOST=smtp.gmail.com
TOUCHLINE_SMTP_PORT=587
TOUCHLINE_SMTP_TIMEOUT=30
TOUCHLINE_SMTP_USERNAME=your-email@example.com
TOUCHLINE_SMTP_PASSWORD=your-smtp-app-password
TOUCHLINE_SMTP_FROM=no-reply@example.com
TOUCHLINE_SMTP_STARTTLS=1

# Generate once with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this value private and stable across restarts/deployments.
TOUCHLINE_2FA_ENCRYPTION_KEY=generate-a-fernet-key

# Google OAuth web sign-in. Keep the client secret private.
TOUCHLINE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
TOUCHLINE_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
TOUCHLINE_GOOGLE_REDIRECT_URI=https://truenas-scale.tail1da715.ts.net/
